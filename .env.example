# ClearClick AI Environment Variables
# AI features are modular: if no key is supplied, ClearClick AI runs offline
# using deterministic rule detectors and heuristic pattern checks. Results are
# warnings for human review and may include false positives or misses.

# Optional: Claude (Anthropic) API Key for Phase 4 text & vision evaluation
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# Provider selection: auto (Gemini first, then Anthropic), gemini, or anthropic
# AI_PROVIDER=auto

# Comma-separated browser origins allowed to call the FastAPI backend.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
